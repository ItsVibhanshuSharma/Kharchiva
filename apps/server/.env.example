NODE_ENV=development
API_PORT=3000
# Set this to the MongoDB Atlas connection string for your deployment.
MONGODB_URI=
REDIS_URL=redis://127.0.0.1:6379

# Populate only when the corresponding integration is implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Use a strong private secret for HS256 access-token verification.
JWT_SECRET=
JWT_ISSUER=kharchiva-api
JWT_AUDIENCE=kharchiva-mobile
OTP_HASH_SECRET=
# Development only: when true outside production, the request response includes debugOtp.
AUTH_DEV_OTP_ENABLED=false
# Production OTP requests fail closed until a vetted SMS provider adapter is configured.
GOOGLE_CLIENT_ID=
# No SMS adapter is implemented yet; setting an API key alone does not enable SMS delivery.
OTP_PROVIDER_API_KEY=
FCM_CREDENTIALS_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
